#!/usr/bin/env bash
set -euo pipefail

# Configuration
REPO_URL="https://github.com/dra11y/opencode.git"
REPO_BRANCH="linear-retry"
INSTALL_DIR="$HOME/.opencode"
TEMP_DIR="/tmp/opencode-install"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT=""
echo "🔧 Installing opencode from $REPO_URL ($REPO_BRANCH branch)"

# 1. Pre-flight Checks
echo ""
echo "📋 Checking prerequisites..."

# Check bun version
if ! command -v bun &> /dev/null; then
  echo "❌ Error: bun is not installed"
  echo "Install bun from https://bun.sh"
  exit 1
fi

BUN_VERSION=$(bun --version | sed 's/bun //')

# Read required version from package.json
if [ ! -f "package.json" ]; then
  echo "❌ Error: package.json not found"
  echo "Failed to read required bun version"
  exit 1
fi

REQUIRED_BUN_VERSION=$(cat package.json | grep -o '"packageManager": "bun@[^"]*"' | sed 's/"packageManager": "bun@//' | sed 's/"//')

if [ -z "$REQUIRED_BUN_VERSION" ]; then
  echo "❌ Error: Could not extract bun version from package.json"
  exit 1
fi

REQUIRED_VERSION_MAJOR=$(echo "$REQUIRED_BUN_VERSION" | cut -d. -f1 | cut -d@ -f1)
REQUIRED_VERSION_MINOR=$(echo "$REQUIRED_BUN_VERSION" | cut -d. -f2)
ACTUAL_VERSION_MAJOR=$(echo "$BUN_VERSION" | cut -d. -f1 | cut -d@ -f1)
ACTUAL_VERSION_MINOR=$(echo "$BUN_VERSION" | cut -d. -f2)

if [ "$ACTUAL_VERSION_MAJOR" -lt "$REQUIRED_VERSION_MAJOR" ] || \
   ([ "$ACTUAL_VERSION_MAJOR" -eq "$REQUIRED_VERSION_MAJOR" ] && [ "$ACTUAL_VERSION_MINOR" -lt "$REQUIRED_VERSION_MINOR" ]); then
  echo "❌ Error: bun version $BUN_VERSION is too old"
  echo "Required: bun >= $REQUIRED_BUN_VERSION"
  echo "Update bun: curl -fsSL https://bun.sh/install | bash"
  exit 1
fi

echo "✅ Bun version: $BUN_VERSION"

# Detect platform
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Determine platform directory
PLATFORM_DIR="opencode-$OS-$ARCH"

# Validate platform directory format
if [[ ! "$PLATFORM_DIR" =~ ^opencode-(darwin|linux|windows)-(arm64|x64)$ ]]; then
  echo "❌ Error: Invalid platform directory: $PLATFORM_DIR"
  echo "Expected format: opencode-(darwin|linux|windows)-(arm64|x64)"
  echo "Detected: OS=$OS, ARCH=$ARCH"
  exit 1
fi

echo "✅ Detected platform: $OS $ARCH (will use $PLATFORM_DIR)"

# Check if running from opencode repository
LOCAL_REPO=false
if [ -f "$SCRIPT_DIR/package.json" ]; then
  REPO_NAME=$(grep '"name"' "$SCRIPT_DIR/package.json" | head -1 | sed 's/.*"name".*: *"\([^"]*\)".*/\1/')
  if [ "$REPO_NAME" = "opencode" ]; then
    LOCAL_REPO=true
    echo "✅ Detected local opencode repository at $SCRIPT_DIR"
  fi
fi

# 2. Clone and Build Fork
echo ""

if [ "$LOCAL_REPO" = true ]; then
  echo "🔨 Installing from local repository..."
  REPO_ROOT="$SCRIPT_DIR"

  cd "$SCRIPT_DIR"

  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "⚠️  Warning: Not a git repository, skipping pull"
  else
    if git status --porcelain 2>/dev/null | grep -q .; then
      echo "⚠️  Warning: Working tree has uncommitted changes"
      echo "Proceeding with current state (not pulling from origin)"
    else
      CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

      if [ "$CURRENT_BRANCH" != "$REPO_BRANCH" ]; then
        echo "⚠️  Warning: On branch '$CURRENT_BRANCH', not '$REPO_BRANCH'"
        echo "Proceeding with current branch"
      fi

      echo "🔄 Attempting to pull latest changes from origin..."
      if ! git pull origin "$CURRENT_BRANCH" 2>/dev/null; then
        echo "⚠️  Warning: git pull failed (origin may not exist)"
        echo "Proceeding with current state"
      fi
    fi
  fi

  echo "✅ Using local repository"
else
  echo "🔨 Cloning repository from GitHub..."

  rm -rf "$TEMP_DIR"
  mkdir -p "$TEMP_DIR"

  if ! git clone "$REPO_URL" "$TEMP_DIR" 2>/dev/null; then
    echo "❌ Error: Failed to clone repository"
    echo "Please check your internet connection and try again"
    exit 1
  fi

  echo "✅ Cloned repository"

  cd "$TEMP_DIR"

  if ! git checkout "$REPO_BRANCH" 2>/dev/null; then
    echo "❌ Error: Branch $REPO_BRANCH not found"
    echo "Available branches:"
    git branch -a
    exit 1
  fi

  echo "✅ Checked out $REPO_BRANCH branch"
  REPO_ROOT="$TEMP_DIR"
fi

# Install dependencies from ROOT
echo ""
echo "📦 Installing dependencies..."
cd "$REPO_ROOT"
bun install

# Build for current platform only
echo ""
echo "🏗️ Building opencode for current platform..."
cd packages/opencode

if ! bun run build --single; then
  echo "❌ Error: Build failed"
  echo "Please check the error messages above"
  exit 1
fi

echo "✅ Build successful"

# 4. Install to ~/.opencode
echo ""
echo "📥 Installing to $INSTALL_DIR..."

# Verify build output
if [ ! -d "dist/$PLATFORM_DIR" ]; then
  echo "❌ Error: Build output not found at dist/$PLATFORM_DIR"
  echo "Available directories:"
  ls dist/
  exit 1
fi

# Create directory structure
mkdir -p "$INSTALL_DIR/bin"

# Copy binary
echo "Copying binary..."
cp "dist/$PLATFORM_DIR/bin/opencode" "$INSTALL_DIR/bin/opencode"
chmod +x "$INSTALL_DIR/bin/opencode"
echo "✅ Installed binary"

# Copy platform package.json
if [ -f "dist/$PLATFORM_DIR/package.json" ]; then
  cp "dist/$PLATFORM_DIR/package.json" "$INSTALL_DIR/package.json"
  echo "✅ Installed package.json"
fi

# 6. Cleanup and Verify
echo ""
echo "🧹 Cleaning up temporary files..."

if [ "$LOCAL_REPO" = false ]; then
  cd /
  rm -rf "$TEMP_DIR"
  echo "✅ Cleaned up temporary directory"
fi

# Verify installation
echo ""
echo "✅ Verifying installation..."

if ! "$INSTALL_DIR/bin/opencode" --version; then
  echo "❌ Error: Installation verification failed"
  echo "Binary not working properly"
  exit 1
fi

# Check if $REPO_BRANCH patch is applied
echo ""
echo "🔍 Checking for $REPO_BRANCH patch..."

if "$INSTALL_DIR/bin/opencode" --help 2>&1 | grep -q "$REPO_BRANCH"; then
  echo "✅ $REPO_BRANCH patch confirmed"
else
  echo "⚠️  Warning: Could not verify $REPO_BRANCH patch (may not be visible in --help output)"
fi

# Success message
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Installation complete!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if [ "$LOCAL_REPO" = true ]; then
  echo "Installed opencode from local repository"
  echo "Source: $SCRIPT_DIR"
else
  echo "Installed opencode from $REPO_BRANCH branch"
fi

echo "Location: $INSTALL_DIR"
echo "Binary: $INSTALL_DIR/bin/opencode"
echo ""
echo "Your configuration files have been preserved."
echo ""
echo "🎉 You can now run: opencode"
echo ""
